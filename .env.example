# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun. .env ASLA GitHub'a gönderilmez (repo herkese açık).
# Hiçbir şey yazmazsanız geliştirme varsayılanları kullanılır (demo için yeterli).

# --- Ortam ---
# Development: Swagger açık, varsayılan anahtarlara izin verilir. Production: anahtarlar zorunlu.
APP_ENV=Development
# Demo şirketleri (Anka Lojistik, Mavi Yazılım) yüklensin mi? Gerçek kurulumda false.
DEMO_DATA=true

# --- Gizli bilgiler (canlıda mutlaka değiştirin) ---
# En az 32 karakter, rastgele. Üretmek için PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_KEY=
DB_PASSWORD=

# --- E-posta (boşsa Mailpit: http://localhost:8025) ---
# Gmail için: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SSL=true, uygulama şifresi
SMTP_HOST=
SMTP_PORT=
SMTP_SSL=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Yapay zekâ ---
# RAG güven eşiği: eval/run_eval.py raporundaki "Önerilen eşik"
RAG_THRESHOLD=0.45

# --- Log ---
# true: satır satır JSON (log toplama araçları için)
LOG_JSON=false
